# Copy to .env.smoke on EC2; never include this file in a release bundle.
# Use the public HTTPS origin to include the outer proxy/TLS in the checks.
# http://frontend is also supported for isolated CI checks on the Docker network.
SMOKE_BASE_URL=https://your-domain.tld
# Dedicated account with TOTP disabled. Reads its own course list only.
SMOKE_EMAIL=release-check@your-domain.tld
SMOKE_PASSWORD=
# A valid, unexpired MCP OAuth token belonging to the same dedicated account.
# Obtain through the normal OAuth flow; renew before its expiration.
SMOKE_MCP_TOKEN=
