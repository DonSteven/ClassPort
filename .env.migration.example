# Copy to .env.migration. Only the maintenance service loads this file.
# The runtime container must never receive this URL or password.
# Both URLs target the SAME database, with different login roles.
MIGRATION_DATABASE_URL=postgresql://classport_migrator:replace-with-migration-password@postgres:5432/classport
PGCONNECT_TIMEOUT=5

# RDS: replace postgres with the RDS endpoint above, enable these settings,
# and place the AWS CA bundle at ./certs/global-bundle.pem.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/classport/certs/global-bundle.pem

# Operator initialization; no SESSION_SECRET or other Web settings required.
OPERATOR_USER_ID=00000000-0000-0000-0000-000000000001
OPERATOR_EMAIL=
OPERATOR_DISPLAY_NAME=Operator
# Generate with: uv run python -m app.tools.hashpw
# Paste the literal $argon2id$... value. Compose loads this file in raw mode.
# Existing password hashes are preserved on subsequent deploys.
APP_PASSWORD_HASH=

# DATABASE_URL is never used as a substitute for MIGRATION_DATABASE_URL.
