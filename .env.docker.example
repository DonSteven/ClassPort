# Local database bootstrap credentials. Used by PostgreSQL, never by the app.
# Match these credentials in .env.migration. Provision classport_app separately.
POSTGRES_USER=classport_migrator
POSTGRES_PASSWORD=replace-with-migration-password
POSTGRES_DB=classport

# Frontend build settings. For RDS deployments only these public settings are
# needed here; local POSTGRES_* settings above may be removed.
PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_SITE_NAME=ClassPort
PUBLIC_SHOW_LANDING=false
PUBLIC_GOOGLE_SITE_VERIFICATION=
