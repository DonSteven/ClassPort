# Task coordination only. Provision this login separately; see docs/DATABASE.md.
DATABASE_URL=postgresql://classport_jobs:replace-with-coordinator-password@postgres:5432/classport
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=2
CELERY_BROKER_URL=redis://redis:6379/0
# RDS deployments also set PGSSLMODE=verify-full and the certificate path.
# PGSSLROOTCERT=/etc/classport/certs/global-bundle.pem
